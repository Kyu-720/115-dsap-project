import time
import random
import matplotlib.pyplot as plt

from TextSearch.text_search import TextSearchSystem


class CompareResult(dict):
    def __repr__(self):
        return self.__str__()

    def __str__(self):
        lines = ["===== Compare Result ====="]

        lines.append("[Exist Queries]")
        for label, t in self.get("exist", {}).items():
            lines.append(f"{label:12s}: {t:.8f} seconds")

        lines.append("-" * 40)

        lines.append("[Not Exist Queries]")
        for label, t in self.get("fake", {}).items():
            lines.append(f"{label:12s}: {t:.8f} seconds")

        lines.append("-" * 40)
        lines.append(f"Queries     : {self.get('Queries', 0)}")
        lines.append("=" * 40)

        return "\n".join(lines)


# ==================================================
# 存在與不存在的測試資料
# ==================================================
def generate_queries(vocab_list, num_queries=100):
    half = num_queries // 2

    if len(vocab_list) < half:
        exist_words = random.choices(vocab_list, k=half)
    else:
        exist_words = random.sample(vocab_list, half)

    fake_words = [word + "_zzz" for word in exist_words]

    return exist_words, fake_words


# ==================================================
# 計時
# ==================================================
def _measure_time(search_system, queries):
    results = {}

    start = time.perf_counter()
    for query in queries:
        search_system._search_word_with_list(query)
    results["list"] = time.perf_counter() - start

    start = time.perf_counter()
    for query in queries:
        search_system._search_word_with_hash_map(query)
    results["dict"] = time.perf_counter() - start

    start = time.perf_counter()
    for query in queries:
        search_system._search_word_with_trie(query)
    results["trie"] = time.perf_counter() - start

    return results


# ==================================================
# 比較不同的資料結構
# ==================================================
def compare_search_speed(search_system: TextSearchSystem, num_queries=100):
    vocab_list = search_system._vocab_list

    if not vocab_list:
        return CompareResult({
            "exist"  : {"list": 0, "dict": 0, "trie": 0},
            "fake"   : {"list": 0, "dict": 0, "trie": 0},
            "Queries": 0
        })

    exist_words, fake_words = generate_queries(vocab_list, num_queries)

    return CompareResult({
        "exist"  : _measure_time(search_system, exist_words),
        "fake"   : _measure_time(search_system, fake_words),
        "Queries": len(exist_words) + len(fake_words)
    })


# ==================================================
# 畫圖
# ==================================================
def show_search_speed_comparison_chart(compare_result: CompareResult):
    if not compare_result.get("Queries"):
        print("No data to display. Please run compare_search_speed() first.")
        return

    labels = ["list", "dict", "trie"]

    exist_values = [compare_result["exist"][label] for label in labels]
    fake_values  = [compare_result["fake"][label]  for label in labels]

    x = range(len(labels))
    width = 0.35

    plt.figure(figsize=(8, 5))

    bars_exist = plt.bar(
        [i - width / 2 for i in x],
        exist_values,
        width=width,
        label="Exist"
    )

    bars_fake = plt.bar(
        [i + width / 2 for i in x],
        fake_values,
        width=width,
        label="Not Exist"
    )

    for bar, t in zip(bars_exist, exist_values):
        plt.text(
            bar.get_x() + bar.get_width() / 2,
            bar.get_height(),
            f"{t:.6f}s",
            ha="center",
            va="bottom",
            fontsize=8
        )

    for bar, t in zip(bars_fake, fake_values):
        plt.text(
            bar.get_x() + bar.get_width() / 2,
            bar.get_height(),
            f"{t:.6f}s",
            ha="center",
            va="bottom",
            fontsize=8
        )

    plt.title("Search Speed Comparison (Exist vs Not Exist)")
    plt.xlabel("Data Structure")
    plt.ylabel("Time (seconds)")
    plt.xticks(list(x), labels)
    plt.legend()
    plt.tight_layout()
    plt.show()
